# Seoul: verify the zone, image, bundle, and regional SSH key before deployment.
# See docs/region/seoul.md before replacing an existing Hong Kong deployment.
# Import the SAME ~/.ssh/beijing-vps.pub key in Seoul under the name seoul-vps.
# Seoul Micro with public IPv4 uses micro_3_0 (Hong Kong uses micro_3_1).
aws_region        = "ap-northeast-2"
availability_zone = "ap-northeast-2a"
instance_name     = "seoul-vpn"
blueprint_id      = "ubuntu_24_04"
bundle_id         = "micro_3_0"
key_pair_name     = "seoul-vps"
reality_sni       = "www.cloudflare.com"
