# Hong Kong: enable the region and verify the zone, image, bundle, and SSH key.
# See docs/region/hong-kong.md before replacing an existing Tokyo deployment.
# Hong Kong Micro with public IPv4 uses micro_3_1 (Tokyo uses micro_3_0).
aws_region        = "ap-east-1"
availability_zone = "ap-east-1a"
instance_name     = "hongkong-vpn"
blueprint_id      = "ubuntu_24_04"
bundle_id         = "micro_3_1"
key_pair_name     = "beijing-vps"
reality_sni       = "www.cloudflare.com"
